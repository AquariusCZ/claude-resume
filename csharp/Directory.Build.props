<Project>
  <PropertyGroup>
    <!--
      NU1900 仅表示"无法从 nuget.org 拉取漏洞数据库"(外网依赖),不代表存在漏洞;
      门禁被外网可用性支配会造成离线环境假失败(实测 2026-08-05)。
      只豁免 NU1900;真实漏洞告警 NU1901/NU1902/NU1903/NU1904 仍由 -warnaserror 拦截。
    -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>

    <!--
      版本号的唯一真身。

      此前它写在 v1 的 `src/package.json` 里,而 v1 运行时已退役删除——
      于是没有任何地方设置版本,程序集回落到默认的 1.0.0,
      而面板铭牌上的 "BUILD" 读的正是 `Assembly.GetName().Version`。
      也就是说那一行**看着像数据,其实是编译器的默认值** ——
      和它取代的那个写死的 "SN ————" 是同一类毛病。

      改版本号只改这里;三个项目(Gui / Worker / Hook)都从这里继承。
    -->
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
