<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- Windows 专属服务:Job Object/DPAPI 均为 Windows 语义(S2-F 起引用 AiResume.Secrets)。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiResume.Worker</RootNamespace>
    <!-- 复用现役 src/icon.ico,不另造图标资产 -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 随产物拷出:创建快捷方式时要指向它 -->
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiResume.Core\AiResume.Core.csproj" />
    <!-- S2-D:ProcessSupervisor 复用 Storage 的 process_registry 表与迁移器 -->
    <ProjectReference Include="..\AiResume.Storage\AiResume.Storage.csproj" />
    <!-- S2-F:日志脱敏与 DPAPI 机密存储 -->
    <ProjectReference Include="..\AiResume.Secrets\AiResume.Secrets.csproj" />
    <!-- S2-G:Named Pipe 服务端(GUI ping/命令) -->
    <ProjectReference Include="..\AiResume.Ipc\AiResume.Ipc.csproj" />
    <!-- S10:preflight 复用 SingleConsumerGuard(单消费者铁律的核验入口) -->
    <ProjectReference Include="..\AiResume.Wrapper\AiResume.Wrapper.csproj" />
    <!-- S12:完成通知经官方 lark-cli 投递(项目规则:不手写同类 SDK 请求) -->
    <ProjectReference Include="..\AiResume.LarkCli\AiResume.LarkCli.csproj" />
  </ItemGroup>
</Project>
