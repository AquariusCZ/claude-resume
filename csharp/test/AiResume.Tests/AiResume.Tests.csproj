    <ProjectReference Include="..\..\src\AiResume.Worker\AiResume.Worker.csproj" />
    <!-- S2-F:DPAPI 机密存储与脱敏测试 -->
    <ProjectReference Include="..\..\src\AiResume.Secrets\AiResume.Secrets.csproj" />
